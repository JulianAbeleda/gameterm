        [
          "entity_type",
          "agent"
        ],
        [
          "phase",
          "idle"
        ],
        [
          "objective",
          "Coordinate the workspace slice"
        ],
        [
          "current_step",
          "waiting to plan"
        ]
      ]
    },
    {
      "id": "scene-verify-process",
      "kind": "Task",
      "label": "Verify Process",
      "position": {
