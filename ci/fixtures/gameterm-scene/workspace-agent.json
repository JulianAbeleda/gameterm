{
  "title": "Scene Agent Workspace",
  "background": "workspace-map",
  "width": 16,
  "height": 9,
  "mode": {
    "mode_id": "workspace",
    "label": "Workspace",
    "description": "Agent and workspace product slice",
    "scene_profile": "scene",
    "allowed_actions": [
      "Inspect",
      "OpenFile",
      "RunCommand",
      "Resolve"
    ],
    "lifecycle": {
      "enter_status": "Workspace overview ready",
      "update_status": "Workspace state refreshed",
      "exit_status": "Workspace overlay closed"
    }
  },
  "layers": [
    {
      "layer_id": "workspace",
      "state": "overview",
      "label": "Workspace"
    },
    {
      "layer_id": "agent",
      "state": "idle",
      "label": "Agent"
    },
    {
      "layer_id": "process",
      "state": "none",
      "label": "Process"
    },
    {
      "layer_id": "ui",
      "state": "scene",
      "label": "UI",
      "input_map": [
        {
          "input": "other",
          "action": "toggle_debug"
        }
      ]
    }
  ],
  "variables": [
    {
      "key": "workspace_mode",
      "value": {
        "Text": "overview"
      }
    },
    {
      "key": "selected_workspace_entity",
      "value": {
        "Text": "workspace-gameterm"
      }
    },
    {
      "key": "active_task_id",
      "value": {
        "Text": "scene-agent-workspace-task"
      }
    },
    {
      "key": "active_agent_id",
      "value": {
        "Text": "scene-agent"
      }
    },
    {
      "key": "agent_phase",
      "value": {
        "Text": "idle"
      }
    },
    {
      "key": "agent_process_phase",
      "value": {
        "Text": "none"
      }
    },
    {
      "key": "process_phase",
      "value": {
        "Text": "none"
      }
    },
    {
      "key": "review_ready",
      "value": {
        "Bool": false
      }
    },
    {
      "key": "verification_status",
      "value": {
        "Text": "not_run"
      }
    },
    {
      "key": "blocker_present",
      "value": {
        "Bool": false
      }
    }
  ],
  "entities": [
