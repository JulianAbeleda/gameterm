# Maintainer:  Wez Furlong <wez at wezfurlong dot org>
# NOTE: if you're looking at this on AUR, this file is generated from
# https://github.com/JulianAbeleda/gameterm/blob/main/ci/PKGBUILD.template
# by automation in the gameterm repo.

pkgname=gameterm-bin
_tag=@TAG@
pkgver=$(echo $_tag | tr - .)
pkgrel=2
pkgdesc='A GPU-accelerated cross-platform terminal emulator and multiplexer implemented in Rust'
arch=('i686' 'x86_64')
url='https://gameterm.org'
license=('MIT')
provides=('gameterm')
conflicts=('gameterm')
# Don't strip: it will break the binary and it only saves ~10% anyway
options=('!strip')
makedepends=('fuse')
depends=(
  'dbus'
  'fontconfig'
  'hicolor-icon-theme'
  'libx11'
  'libxkbcommon-x11'
  'wayland'
  'xcb-util-keysyms'
  'xcb-util-wm'
)
optdepends=(
  'python-nautilus: GameTerm context menu in Nautilus'
)
source=(
  "gameterm::https://github.com/JulianAbeleda/gameterm/releases/download/${_tag}/GameTerm-${_tag}-Ubuntu16.04.AppImage"
  'LICENSE::https://github.com/JulianAbeleda/gameterm/raw/main/LICENSE.md'
)
sha256sums=(
  '@SHA256@'
  'ad915d9508677a4e94e4b3c0a045fedd20e953d95d7cd3ec97e6d16840fa0ed5'
)

prepare() {
  chmod +x "${srcdir}/gameterm"
}

pkgver() {
  "${srcdir}/gameterm" --version | cut -d' ' -f2 | tr - .
}

build() {
  "${srcdir}/gameterm" --appimage-extract >/dev/null
}

package() {
  install -Dm755 squashfs-root/usr/bin/gameterm -t "${pkgdir}/usr/bin/"
  install -Dm755 squashfs-root/usr/bin/gameterm-gui -t "${pkgdir}/usr/bin/"
  install -Dm755 squashfs-root/usr/bin/gameterm-mux-server -t "${pkgdir}/usr/bin/"
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
  install -Dm644 squashfs-root/usr/share/icons/hicolor/128x128/apps/org.wezfurlong.gameterm.png \
                 "${pkgdir}/usr/share/icons/hicolor/128x128/apps/org.wezfurlong.gameterm.png"
  install -Dm644 squashfs-root/usr/share/applications/org.wezfurlong.gameterm.desktop \
                 "${pkgdir}/usr/share/applications/org.wezfurlong.gameterm.desktop"
  install -Dm644 squashfs-root/usr/share/nautilus-python/extensions/gameterm-nautilus.py \
                 "${pkgdir}/usr/share/nautilus-python/extensions/gameterm-nautilus.py"
}
