#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "${script_path}" ]]; do
  script_dir="$(cd "$(dirname "${script_path}")" && pwd)"
  script_path="$(readlink "${script_path}")"
  [[ "${script_path}" = /* ]] || script_path="${script_dir}/${script_path}"
done

repo_root="$(cd "$(dirname "${script_path}")/../.." && pwd)"
tts_script="${repo_root}/ci/scene-tts/voicevox-en-to-ja.sh"

if [[ ! -x "${tts_script}" ]]; then
  echo "missing executable TTS script: ${tts_script}" >&2
  exit 1
fi

if [[ $# -gt 0 ]]; then
  text="$*"
else
  text="$(cat)"
fi

if [[ -z "${text//[[:space:]]/}" ]]; then
  echo "usage: vs TEXT" >&2
  echo "   or: echo TEXT | vs" >&2
  exit 2
fi

output="$(mktemp "${TMPDIR:-/tmp}/gameterm-vs.XXXXXX.wav")"
cleanup() {
  rm -f "${output}"
}
trap cleanup EXIT

printf '%s' "${text}" | GAMETERM_SCENE_TTS_OUTPUT="${output}" "${tts_script}"

if [[ -s "${output}" ]]; then
  afplay "${output}"
fi
